# Copie para .env (flask run) ou .env.dev / .env.prod (tarefas do invoke).
# Os arquivos .env.* reais NAO devem ser versionados.
FLASK_APP=app
FLASK_CONFIG=development
FLASK_DEBUG=1

# Gere valores aleatorios com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
JWT_SECRET_KEY=troque-esta-chave-tambem

# Desenvolvimento usa SQLite. Em producao, MySQL:
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost/treinolog?charset=utf8mb4
DATABASE_URL=sqlite:///treinolog.db

# Logging: DEBUG, INFO, WARNING ou ERROR. O arquivo fica em LOG_DIR/treinolog.log
LOG_LEVEL=INFO
LOG_DIR=logs
